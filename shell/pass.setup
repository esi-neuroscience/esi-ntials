# Define a function that accepts arbitrary inputs
process_all()
{
    echo "This is what I got: $*"
}

# Define a function that converts its input to an array
process_arrays()
{
    local arr=("$@")
    echo "The length of the array is ${#arr[@]}"
    echo "This is its first element: ${arr[0]}"
    if ((BASH_VERSINFO >= 4)); then
        lastel="${arr[-1]}"             # simplified on modern Linux
    else
        lastel="${arr[${#arr[@]} - 1]}" # old style in old bash (e.g., macOS)
    fi
    echo "This is its last element: ${lastel}"
    echo "This is the whole thing: ${arr[@]}"
}
