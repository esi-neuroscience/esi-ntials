# String formatters to prettify output
if [[ -t 1 ]]; then
  tty_escape() { printf "\033[%sm" "$1"; }
else
  tty_escape() { :; }
fi
tty_mkbold() { tty_escape "1;$1"; }
tty_blue="$(tty_mkbold 34)"
tty_green="$(tty_mkbold 32)"
tty_magenta="$(tty_mkbold 35)"
tty_red="$(tty_mkbold 31)"
tty_bold="$(tty_mkbold 39)"
tty_reset="$(tty_escape 0)"

# Print string perserving special characters formatting (like newlines)
shell_join()
{
  local arg
  printf "%s" "$1"
  shift
  for arg in "$@"
  do
    printf " "
    printf "%s" "${arg// /\ }"
  done
}

# Print string with formating removed
chomp()
{
  printf "%s" "${1/"$'\n'"/}"
}

# Special print functions specifically for tests
debug()
{
  if [[ -n "${testsdebug-}" ]]; then
    printf "${tty_blue}DEBUG: ${tty_reset}%s\n" "$(shell_join "$@")"
  fi
}

passed()
{
  printf "${tty_green}PASSED: ${tty_reset}%s\n" "$(shell_join "$@")"
}

info()
{
  printf "${tty_blue}===${tty_bold} %s${tty_reset}\n" "$(shell_join "$@")"
}

warn()
{
  printf "${tty_magenta}WARNING:${tty_bold} %s${tty_reset}\n" "$(chomp "$1")"
}

error()
{
  printf "${tty_red}FAILED:${tty_bold} %s${tty_reset}\n" "$(chomp "$1")"
}
